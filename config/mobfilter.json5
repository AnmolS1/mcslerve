//

{
	"rules" : [
		{
			"name" : "Valley of PEACE",
			"what" : "DISALLOW_SPAWN",
			"when": {
				"category": [ "MONSTER" ],
				"dimensionId" : [ "minecraft:overworld" ],
				"blockX": [-2488, -2392],
				"blockY": [-321, 512],
				"blockZ": [-2963, -2737]
			}
		}
	],
	"logLevel" : "INFO"
}
